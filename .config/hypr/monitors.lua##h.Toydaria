hl.monitor({ output = "DP-1", mode = "2560x1440", position = "0x0", scale = 1 })
hl.monitor({ output = "DP-3", mode = "2560x1440", position = "2560x0", scale = 1 })
hl.monitor({ output = "HDMI-A-1", mode = "1920x1080", position = "2560x0", scale = 1, mirror = "DP-1" })

for _, workspace in ipairs({ 1, 3, 5, 7, 9 }) do
    hl.workspace_rule({
        workspace = tostring(workspace),
        monitor = "DP-1",
        persistent = true,
        default = workspace == 1,
    })
end

for _, workspace in ipairs({ 2, 4, 6, 8, 10 }) do
    hl.workspace_rule({
        workspace = tostring(workspace),
        monitor = "DP-3",
        persistent = true,
        default = workspace == 2,
    })
end
