-- Keep the switch bind after monitor rules; this avoids a Hyprland 0.55/0.56
-- initialization issue seen with switch binds declared before monitors.
hl.bind("switch:Lid Switch", hl.dsp.exec_cmd("~/.config/hypr/switch.sh"), { locked = true })
