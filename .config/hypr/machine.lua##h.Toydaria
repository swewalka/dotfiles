-- Only settings specific to this machine belong here.
return {
    -- The HDMI mirror can transfer its temporary workspace to DP-1.
    startup_workspace = 1,
    configure_hardware = function()
        hl.monitor({ output = "DP-1", mode = "2560x1440", position = "0x0", scale = 1 })
        hl.monitor({ output = "DP-3", mode = "2560x1440", position = "2560x0", scale = 1 })
        hl.monitor({ output = "HDMI-A-1", mode = "1920x1080", position = "2560x0", scale = 1, mirror = "DP-1" })

        for _, workspace in ipairs({ 1, 3, 5, 7, 9 }) do
            hl.workspace_rule({
                workspace = tostring(workspace),
                monitor = "DP-1",
                persistent = true,
                default = workspace == 1,
            })
        end

        for _, workspace in ipairs({ 2, 4, 6, 8, 10 }) do
            hl.workspace_rule({
                workspace = tostring(workspace),
                monitor = "DP-3",
                persistent = true,
                default = workspace == 2,
            })
        end

        hl.env("LIBVA_DRIVER_NAME", "nvidia")
        hl.env("XDG_SESSION_TYPE", "wayland")
        hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")

        hl.config({
            cursor = {
                no_hardware_cursors = true,
            },
        })
    end,
}
