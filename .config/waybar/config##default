// Machine layout; edit shared/modules.jsonc for common settings.
{
  "include": "shared/modules.jsonc",
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "battery",
    "pulseaudio",
    "tray",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": " "
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 4,
      "HDMI-A-1": 3
    }
  }
}
