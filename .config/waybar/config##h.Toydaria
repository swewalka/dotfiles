// Machine layout; edit shared/modules.jsonc for common settings.
{
  "include": "shared/modules.jsonc",
  "modules-center": [
    "ext/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "tray",
    "clock",
    "custom/power"
  ],
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": " "
    },
    "sort-by-name": true
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout -b 5 --protocol layer-shell"
  }
}
